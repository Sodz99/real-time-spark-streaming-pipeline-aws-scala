# Code-only whitelist: ignore everything, then allow source files back in
*
!*/
!.gitignore
!.gitattributes
!*.py
!*.ipynb
!*.sql
!*.r
!*.R
!*.sh
!*.ps1
!*.bat
!*.js
!*.ts
!*.html
!*.css
!*.java
!*.scala
!*.yml
!*.yaml
!*.toml
!*.cfg
!*.ini
!*.conf
!*.md
!requirements*.txt
!Dockerfile
!Makefile
!Procfile
!.env.example

# Never commit, even inside allowed folders
**/__pycache__/
**/.ipynb_checkpoints/
**/__MACOSX/
**/venv/
**/.venv/
**/env/
**/site-packages/
**/node_modules/
**/.env
**/.env.*
!**/.env.example
**/data/
**/input/
**/Database_backup/
**/.conda/
**/cdk.out/
**/TOS_DI-*/
**/darknet/
**/labelImg-master/
**/jTessBoxEditor*/
**/Tesseract-OCR/

# Bundled third-party packages
/Lambda_code_with_dependencies_updated/bin/
/Lambda_code_with_dependencies_updated/numpy.libs/
/Lambda_code_with_dependencies_updated/numpy/

# Too large or duplicate
/Lambda_code_with_dependencies_updated/lambda_function.py
